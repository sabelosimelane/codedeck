{
  "mode": "denylist",
  "allowedCommands": [],
  "deniedCommands": [
    "rm -rf*",
    "rm -fr*",
    "sudo*",
    "su*",
    "dd*",
    "mkfs*",
    "shutdown*",
    "reboot*",
    "halt*",
    "poweroff*",
